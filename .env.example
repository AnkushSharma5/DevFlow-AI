# ==================================================
# DEVFLOW AI — Environment Variables Example
# ==================================================
# Copy this file to server/.env and fill in values.
# Never commit the real .env file to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local: mongodb://localhost:27017/devflow
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/devflow
MONGO_URI=mongodb://localhost:27017/devflow

# --- JWT ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# --- AI Provider ---
# Options: "gemini" (default) | "openai"
AI_PROVIDER=gemini

# Google Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key — only required when AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o
